# Local dev (vite.config.ts) and Cloudflare Pages (functions/) proxy /v1 and /api to the API, so this stays empty.
VITE_API_BASE_URL=

# Chrome Web Store id of the companion extension (externally_connectable bridge).
# For an unpacked dev build, set it in .env.local or via the Extension ID field in Settings.
# Defaults to the released id (plkniphjimejobodnkckdjndalimcicp); set only to test a differently keyed build.
VITE_EXTENSION_ID=

# Community invite shown on the Companies page; leave empty to hide the Discord button.
VITE_DISCORD_URL=
